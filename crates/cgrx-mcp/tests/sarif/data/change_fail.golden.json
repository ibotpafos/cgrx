      ],
      "tool": {
        "driver": {
          "fullName": "CGRX code graph gates",
          "informationUri": "https://github.com/ibotpafos/cgrx",
          "name": "cgrx",
          "rules": [
            {
              "fullDescription": {
                "text": "Snapshot-bound CGRX quality-gate verdict. No tests or LLM were executed."
              },
              "id": "cgrx/gate-verdict",
              "name": "GateVerdict",
              "shortDescription": {
                "text": "Overall CGRX change gate verdict."
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Change findings above the warning budget."
              },
              "id": "cgrx/max_warning_findings",
              "name": "max_warning_findings",
              "properties": {
                "severity": "error",
                "threshold": 0
              },
              "shortDescription": {
                "text": "Change findings above the warning budget."
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Blocked change missions above the budget."
              },
              "id": "cgrx/max_blocked_missions",
              "name": "max_blocked_missions",
              "properties": {
                "severity": "error",
                "threshold": 0
              },
              "shortDescription": {
                "text": "Blocked change missions above the budget."
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Index coverage gaps above the budget."
              },
              "id": "cgrx/max_coverage_gaps",
              "name": "max_coverage_gaps",
              "properties": {
                "severity": "error",
                "threshold": 0
              },
              "shortDescription": {
                "text": "Index coverage gaps above the budget."
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Unverified blast-radius impacts above the budget."
              },
              "id": "cgrx/max_unverified_impacts",
              "name": "max_unverified_impacts",
              "properties": {
                "severity": "warning",
                "threshold": 0
              },
              "shortDescription": {
                "text": "Unverified blast-radius impacts above the budget."
              }
            }
          ],
          "version": "0.1.0-alpha.8"
        }
