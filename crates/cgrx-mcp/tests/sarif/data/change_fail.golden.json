{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "automationDetails": {
        "id": "cgrx/change-gates"
      },
      "properties": {
        "cgrxAlgorithm": "change_quality_gate_v1",
        "cgrxFailOn": "error",
        "cgrxGate": "change",
        "cgrxPartial": false,
        "cgrxVerdict": "FAIL",
        "cgrxWouldBlock": true,
        "llmUsed": false
      },
      "results": [
        {
          "level": "error",
          "message": {
            "text": "cgrx change gate verdict FAIL (fail_on=error, would_block=true)"
          },
          "ruleId": "cgrx/gate-verdict"
        },
        {
          "level": "error",
          "message": {
            "text": "cgrx max_warning_findings breached: value 2 exceeds threshold 0 (severity error)"
          },
          "ruleId": "cgrx/max_warning_findings"
        },
        {
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/broken.ts"
                },
                "region": {
                  "byteLength": 25,
                  "byteOffset": 0
                }
              }
            }
          ],
          "message": {
            "text": "cgrx coverage gap PARSER_ERROR_RANGE: src/broken.ts:0-25"
          },
          "ruleId": "cgrx/max_coverage_gaps"
        },
        {
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "vendor/gen.ts"
                }
              }
            }
          ],
          "message": {
            "text": "cgrx coverage gap EXCLUDED_PATH: vendor/gen.ts"
          },
          "ruleId": "cgrx/max_coverage_gaps"
        },
        {
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/moved.ts"
                }
              }
            }
          ],
          "message": {
            "text": "cgrx coverage gap STALE_PATH: src/moved.ts"
          },
          "ruleId": "cgrx/max_coverage_gaps"
        },
        {
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/dyn.ts"
                }
              }
