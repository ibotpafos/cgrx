        },
        {
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/other.ts"
                }
              }
            }
          ],
          "message": {
            "text": "cgrx coverage gap DYNAMIC_DISPATCH: src/other.ts:1-2"
          },
          "ruleId": "cgrx/max_coverage_gaps"
        },
        {
          "level": "error",
          "message": {
            "text": "cgrx max_coverage_gaps breached: value 5 exceeds threshold 0 (severity error)"
          },
          "relatedLocations": [
            {
              "id": 1,
              "message": {
                "text": "cgrx coverage gap PARSER_ERROR_RANGE: src/broken.ts:0-25"
              },
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/broken.ts"
                },
                "region": {
                  "byteLength": 25,
                  "byteOffset": 0
                }
              }
            },
            {
              "id": 2,
              "message": {
                "text": "cgrx coverage gap EXCLUDED_PATH: vendor/gen.ts"
