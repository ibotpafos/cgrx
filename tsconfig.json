{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": [
    "crates/cgrx-cli/web/types.ts",
    "crates/cgrx-cli/web/project-three.ts",
    "crates/cgrx-cli/web/app.tsx",
    "crates/cgrx-cli/web/git-history.ts",
    "crates/cgrx-cli/web/runtime-evidence.ts",
    "crates/cgrx-cli/web/vendor-entry.ts"
  ]
}
