{
  "name": "cgrx-graph-explorer",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web-vendor": "esbuild crates/cgrx-cli/web/vendor-entry.ts --bundle --format=esm --minify --legal-comments=none --outfile=crates/cgrx-cli/web/vendor/web-git-graph.js && esbuild crates/cgrx-cli/web/git-history.ts --bundle --format=esm --minify --legal-comments=none --outfile=crates/cgrx-cli/web/vendor/git-history.js",
    "typecheck:web": "tsc --noEmit",
    "verify:web-csp": "node scripts/verify_web_git_graph_csp.mjs",
    "test": "node --test crates/cgrx-cli/web/tests/*.test.js"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "dependencies": {
    "@web-git-graph/protocol": "1.0.7",
    "@web-git-graph/web": "1.0.7"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "typescript": "6.0.2"
  }
}
